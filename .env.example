# Copy to .env and fill in. .env is gitignored and never copied into the
# image (see .dockerignore); compose reads it for both services.
#
#   cp .env.example .env && docker compose up -d --wait

# --- Database ---------------------------------------------------------------
# DB_PASSWORD is required: compose interpolates it into POSTGRES_PASSWORD for
# the db service and fails fast with a named error if it is unset.
DB_PASSWORD=change_me

# Host and port for a LOCAL (non-compose) run. Inside the compose network the
# app service overrides DB_HOST to `db` and DB_PORT to 5432, so these values
# only matter when running `npm start` directly against a local Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=provider_intelligence
DB_USER=admin

# --- Application ------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
